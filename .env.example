# Copy to .env for local development (.env is gitignored; never commit real values).

# Local dev: leave DATABASE_URL empty to use the embedded PGlite database in ./.pglite
DATABASE_URL=
PORT=3000
PUBLIC_URL=http://localhost:3000

# Local-only shortcut login. Must stay off in production (the server refuses to start).
DEV_LOGIN=true

# Google Workspace sign-in (OAuth client from Google Cloud Console, owned by a Qlub account).
# Authorized redirect URI: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=qlub.io

# Production: set in Railway variables. At least 32 random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=12
