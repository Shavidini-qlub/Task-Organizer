{
  "name": "task-organizer",
  "version": "0.1.0",
  "private": true,
  "description": "A to-do list that never drops a task: undone tasks carry forward into today's list.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "connect-pg-simple": "10.0.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "google-auth-library": "11.3.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}
